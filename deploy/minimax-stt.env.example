# Required: MiniMax API key. Do not commit a real key.
MINIMAX_API_KEY=replace-with-your-minimax-api-key

# Recommended when the proxy is exposed beyond localhost.
# Clients must send: Authorization: Bearer <this-value>
PROXY_API_KEY=replace-with-a-long-random-proxy-key

# These values can be used by Docker Compose or a direct Bun process.
HOST=0.0.0.0
PORT=18080
MINIMAX_BASE_URL=https://api.minimax.cn
REQUEST_TIMEOUT_MS=120000
