# Required: MiniMax API key from https://platform.minimax.cn/
MINIMAX_API_KEY=your-minimax-api-key

# Optional: protect this proxy from unauthenticated callers.
# When set, clients must send Authorization: Bearer $PROXY_API_KEY.
PROXY_API_KEY=

# Optional server configuration.
HOST=0.0.0.0
PORT=18080
MINIMAX_BASE_URL=https://api.minimax.cn
REQUEST_TIMEOUT_MS=120000
